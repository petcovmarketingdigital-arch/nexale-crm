{
  "name": "nexale-crm",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://app.nexalecrm.com.br/api/:path*"
    },
    {
      "source": "/evolution/:path*",
      "destination": "https://app.nexalecrm.com.br/evolution/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
